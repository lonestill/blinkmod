<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/blinkmod_widget_bg">
    <ImageView
        android:id="@+id/widget_map_preview"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginRight="12dp"
        android:scaleType="centerCrop"
        android:contentDescription="Метка друга на карте"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="BlinkMod"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Друг на карте"
            android:textColor="#FFD8D8DF"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="позиция из Blink"
            android:textColor="#FF9898A3"
            android:textSize="12sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_settings"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="⚙"
        android:textColor="#FFB9B9C2"
        android:textSize="18sp"
        android:contentDescription="Настройки виджета"/>
    <TextView
        android:id="@+id/widget_refresh"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="↻"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:contentDescription="Обновить"/>
</LinearLayout>
