<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/blinkmod_widget_bg">
    <ImageView android:id="@+id/nearby_radar" android:layout_width="104dp" android:layout_height="104dp" android:layout_marginRight="13dp" android:scaleType="centerCrop" android:contentDescription="Радар друзей"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Кто рядом" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/nearby_refresh" android:layout_width="38dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textColor="#FFFFFFFF" android:textSize="21sp" android:contentDescription="Обновить"/>
        </LinearLayout>
        <TextView android:id="@+id/nearby_1" android:layout_width="match_parent" android:layout_height="25dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF1EEFF" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/nearby_2" android:layout_width="match_parent" android:layout_height="25dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#FFD2D2DB" android:textSize="13sp"/>
        <TextView android:id="@+id/nearby_3" android:layout_width="match_parent" android:layout_height="25dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#FFAAAAB5" android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
